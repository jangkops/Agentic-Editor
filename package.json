{
  "name": "ai-editor",
  "version": "0.3.0",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/setup-venv.js && (lsof -ti:8765 | xargs kill -9 2>/dev/null || true)",
    "dev:python": "ai_engine/.venv/bin/python -m uvicorn ai_engine.server:app --reload --reload-dir ai_engine --port 8765 --workers 1 --timeout-keep-alive 300",
    "dev:electron": "wait-on http://localhost:8765/health && electron .",
    "dev": "concurrently \"npm:dev:python\" \"npm:dev:electron\"",
    "setup:venv": "node scripts/setup-venv.js",
    "build:python": "node scripts/build-python.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "npm run build:python && electron-builder",
    "test:unit": "jest tests/unit/ --coverage",
    "test:e2e": "python -m pytest tests/e2e/ -v",
    "test": "npm run test:unit",
    "postinstall": "npx @electron/rebuild -f -w node-pty || echo 'electron-rebuild skipped'"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "concurrently": "^8.2.0",
    "electron-builder": "^24.0.0",
    "jest": "^29.7.0",
    "wait-on": "^7.0.0"
  }
}
